# palka — local QVAC only; network comes from the wallet adapter.
# Public example: create distinct random local tokens before running profiles.
# The application does not automatically load .env. Export the needed variables
# or use `npm run dev:mock`, which generates local tokens and isolated state.
# Docker Compose generates persistent local tokens itself and needs no .env.

# Optional legacy mapping: token -> owner ID. Existing profiles keep their tokens.
# New desktops self-register when enabled. deploy/compose.yaml enables it by default.
# MARKET_SELF_REGISTRATION=true
MARKET_PORT=4100
MARKET_DB_PATH=.state/market.sqlite
MARKET_TOKENS_JSON='{"replace-market-token-a":"A","replace-market-token-b":"B","replace-market-token-c":"C"}'

# Local client A. Run B/C separately with ports 4102/4103 and separate state dirs.
LOCAL_OWNER_ID=A
LOCAL_PORT=4101
# Keep loopback for native use. Docker's demo runner explicitly sets 0.0.0.0
# inside its container and publishes ports only on the host's 127.0.0.1.
# LOCAL_HOST=127.0.0.1
LOCAL_STATE_DIR=.state/local-real-A
# Only the local wallet's own origin; the public market must not access it.
LOCAL_ALLOWED_ORIGINS=http://127.0.0.1:4101,http://localhost:4101
MARKET_URL=http://127.0.0.1:4100
MARKET_TOKEN=replace-market-token-a
# Desktop sets MARKET_AUTO_REGISTER for new automatic profiles. Do not enable it
# for an existing named wallet; preserve that wallet's original owner ID/token.
# Optional: if omitted a random pairing token is stored in LOCAL_STATE_DIR/session-token.
# LOCAL_SESSION_TOKEN=replace-with-at-least-32-random-characters

# A missing real adapter remains visibly unavailable; it never falls back to mock.
WALLET_MODE=real
# For the loopback adapter supplied by developer B:
# WALLET_RPC_URL=http://127.0.0.1:4201
# WALLET_RPC_TOKEN=replace-with-a-distinct-local-sidecar-token
# Explicit synthetic testing only: WALLET_MODE=mock, or npm run dev:mock.
# Docker's three-wallet demo is opt-in: PALKA_DEMO_MODE=true.

# QVAC SDK 0.21.1 + local QWEN3_1_7B_INST_Q4 model.
# Requires Node >=22.17 (pinned workspace runtime is installed by npm).
# No inference API key required. First load downloads public model weights;
# subsequent inference runs locally, with no cloud model fallback.
# Optional SDK configuration path; keep prompt/content logging disabled:
# QVAC_CONFIG_PATH=/absolute/path/to/local-qvac-config.json
# Force CPU inference (set automatically by the Docker runtime image):
# QVAC_DEVICE=cpu
