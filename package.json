{
  "name": "palka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev:market": "tsx apps/market/src/main.ts",
    "dev:local": "tsx apps/local-client/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/contracts/test/*.test.ts apps/market/test/*.test.ts apps/local-client/test/*.test.ts apps/web/src/test/*.test.ts apps/desktop/test/*.test.ts",
    "build": "npm run build:web && npm run build:local",
    "smoke:qvac": "tsx apps/local-client/scripts/qvac-smoke.ts",
    "dev:mock": "tsx apps/local-client/scripts/dev-mock.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:local": "vite build --config apps/local-client/ui/vite.config.ts",
    "predev:mock": "npm run build:local",
    "build:desktop": "tsx apps/desktop/scripts/build.ts",
    "dev:desktop": "npm run build:local && npm run build:desktop && electron .",
    "package:desktop": "tsx apps/desktop/scripts/package.ts",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:python && npm run lint:rust",
    "lint:js": "eslint . --max-warnings 0",
    "lint:python": "uv run --locked ruff check .",
    "lint:rust": "cargo clippy --locked --manifest-path packages/wallet/native/Cargo.toml --all-targets --no-deps -- -D warnings",
    "format": "npm run format:web && npm run format:python && npm run format:rust",
    "format:web": "prettier --write \"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,css,html,yml,yaml}\"",
    "format:python": "uv run --locked ruff format .",
    "format:rust": "cargo fmt --manifest-path packages/wallet/native/Cargo.toml && rustfmt --edition 2024 packages/wallet/native/extension.rs",
    "format:check": "npm run format:check:web && npm run format:check:python && npm run format:check:rust",
    "format:check:web": "prettier --check \"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,css,html,yml,yaml}\"",
    "format:check:python": "uv run --locked ruff format --check .",
    "format:check:rust": "cargo fmt --manifest-path packages/wallet/native/Cargo.toml --check && rustfmt --edition 2024 --check packages/wallet/native/extension.rs",
    "test:python": "uv run --locked python -m unittest discover -s packages/wallet -p \"test_*.py\"",
    "test:wallet": "node --test packages/wallet/adapter.test.mjs",
    "test:deploy": "uv run --locked python -m unittest discover -s deploy -p \"test_*.py\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:wallet && npm run test:python && npm run test:deploy && npm run build",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix && npm run lint:python -- --fix"
  },
  "dependencies": {
    "@qvac/sdk": "0.21.1",
    "@tetherto/wdk-wallet-btc": "1.0.0-beta.17",
    "b4a": "1.9.0",
    "bip39": "3.1.0",
    "bitcoinjs-lib": "7.0.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.7.0",
    "ws": "8.22.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.13.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "electron": "44.9.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "node": "22.17.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4"
  },
  "main": "apps/desktop/dist/main.cjs"
}
