{
  "extends": ["stylelint-config-recommended"],
  "ignoreFiles": [
    "**/node_modules/**",
    "**/dist/**",
    ".dist/**",
    "**/vendor/**",
    ".state/**",
    ".qvac/**",
    ".venv/**",
    "**/state/**",
    "**/target/**",
    "tools/**"
  ],
  "rules": {
    "no-descending-specificity": null,
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "apply",
          "source",
          "utility",
          "variant",
          "custom-variant",
          "reference"
        ]
      }
    ]
  }
}
